# MagicPen environment — copy these into .env.local and fill in your values.
#   cp .env.example .env.local

# ------------------------------ AI · Google Gemini ------------------------------
# Get a key at https://aistudio.google.com/apikey
# MagicPen uses a single model: gemini-3.1-flash-lite (newest stable lite —
# high free-tier daily quota). Check your key's exact limits at ai.dev/rate-limit.
GEMINI_API_KEY=

# Optional override (e.g. gemini-3.5-flash for top quality — note its free
# tier allows only ~20 requests/day; enable billing for real use):
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: try the whole app with canned AI responses (no key needed).
# Remove this once you add a real GEMINI_API_KEY.
# MOCK_AI=1

# ---------------------------------- Auth ----------------------------------------
# Secret used to sign session JWTs (any long random string, e.g. `openssl rand -hex 32`).
# REQUIRED in production. In dev, a random secret is generated into .data/auth-secret.
AUTH_SECRET=

# ------------------------------ Database · MongoDB ------------------------------
# e.g. mongodb+srv://user:pass@cluster.mongodb.net or mongodb://127.0.0.1:27017
# Stores users (email + scrypt password hash), documents, chats, and change history.
# If left empty, MagicPen falls back to a local JSON store in .data/ (dev only).
MONGODB_URI=
MONGODB_DB=magicpen

# --------------------- Supabase · Storage only (optional) -----------------------
# Used exclusively to archive original uploaded files in a PRIVATE bucket,
# server-side. Project Settings → API keys → use the secret key (sb_secret_...);
# it never reaches the browser. Leave empty to skip archiving.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=magicpen

# ------------------------------ Slack integration ------------------------------
# Optional. Powers the MagicPen Slack bot (generate/edit/commit/retrieve/upload
# from Slack). Leave empty to disable. Create an app at https://api.slack.com/apps
# (Create from scratch — the workspace you pick there is only your dev/home
# workspace; other orgs install via OAuth once Public Distribution is enabled).
#
# Bot scopes: app_mentions:read, chat:write, im:history, im:read, im:write,
#             files:read, files:write, commands, users:read
#             (files:write is required so the bot can send documents as files)
# Event subscriptions (Request URL = APP_BASE_URL/api/slack/events):
#             app_mention, message.im
# Interactivity Request URL:  APP_BASE_URL/api/slack/interactivity
# Slash command /magicpen  ->  APP_BASE_URL/api/slack/commands
# OAuth Redirect URL:         APP_BASE_URL/api/slack/oauth
#
# IMPORTANT: keep Socket Mode OFF. This integration uses HTTP webhooks; Socket
# Mode makes Slack deliver events over a WebSocket instead, so the Request URLs
# above never fire. Also re-install the app after changing scopes/events.
#
# From the app's "Basic Information" page:
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional single-workspace fallback: the Bot User OAuth Token (xoxb-...) from
# the app's "OAuth & Permissions" page. Used only when there's no stored OAuth
# install for a workspace — handy for your own dev/home workspace. For real
# multi-workspace / public distribution leave this empty; each install captures
# its own bot token through the OAuth flow (/api/slack/oauth).
SLACK_BOT_TOKEN=

# The PUBLIC https origin where this app is reachable (Slack must reach it, and
# it builds the connect/redirect/deep links). No trailing slash. In local dev
# use a tunnel (e.g. ngrok http 3000) — not http://localhost:3000.
APP_BASE_URL=

# ------------------------- Google Docs add-on -------------------------------
# Optional. Powers the MagicPen Google Docs sidebar add-on (edit the open doc
# with AI). The add-on itself is a separate Google Apps Script project; it calls
# this app's /api/gdocs/* endpoints over HTTPS. Leave empty to disable.
#
# Shared secret the add-on sends on every request (header: X-MagicPen-Addon).
# Generate any long random string, e.g. `openssl rand -hex 32`, then store the
# SAME value in the Apps Script project's Script Properties as GDOCS_ADDON_SECRET.
# This also signs the account-linking connect state, so the endpoints stay closed
# until it's set. Reuses APP_BASE_URL above for the connect link (/gdocs/connect).
GDOCS_ADDON_SECRET=
