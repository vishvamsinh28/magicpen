# SuperDocs environment — copy these into .env.local and fill in your values.
#   cp .env.example .env.local

# ------------------------------ AI · Google Gemini ------------------------------
# Get a key at https://aistudio.google.com/apikey
# SuperDocs uses a single model: gemini-3.1-flash-lite (newest stable lite —
# high free-tier daily quota). Check your key's exact limits at ai.dev/rate-limit.
GEMINI_API_KEY=

# Optional override (e.g. gemini-3.5-flash for top quality — note its free
# tier allows only ~20 requests/day; enable billing for real use):
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: try the whole app with canned AI responses (no key needed).
# Remove this once you add a real GEMINI_API_KEY.
# MOCK_AI=1

# ---------------------------------- Auth ----------------------------------------
# Secret used to sign session JWTs (any long random string, e.g. `openssl rand -hex 32`).
# REQUIRED in production. In dev, a random secret is generated into .data/auth-secret.
AUTH_SECRET=

# ------------------------------ Database · MongoDB ------------------------------
# e.g. mongodb+srv://user:pass@cluster.mongodb.net or mongodb://127.0.0.1:27017
# Stores users (email + scrypt password hash), documents, chats, and change history.
# If left empty, SuperDocs falls back to a local JSON store in .data/ (dev only).
MONGODB_URI=
MONGODB_DB=superdocs

# --------------------- Supabase · Storage only (optional) -----------------------
# Used exclusively to archive original uploaded files in a PRIVATE bucket,
# server-side. Project Settings → API keys → use the secret key (sb_secret_...);
# it never reaches the browser. Leave empty to skip archiving.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=superdocs

# ------------------------------ Slack integration ------------------------------
# Optional. Powers the SuperDocs Slack bot (generate/edit/commit/retrieve/upload
# from Slack). Leave empty to disable. Create an app at https://api.slack.com/apps
# (Create from scratch — the workspace you pick there is only your dev/home
# workspace; other orgs install via OAuth once Public Distribution is enabled).
#
# Bot scopes: app_mentions:read, chat:write, im:history, im:read, im:write,
#             files:read, commands, users:read
# Event subscriptions (Request URL = APP_BASE_URL/api/slack/events):
#             app_mention, message.im
# Interactivity Request URL:  APP_BASE_URL/api/slack/interactivity
# Slash command /superdoc  ->  APP_BASE_URL/api/slack/commands
# OAuth Redirect URL:         APP_BASE_URL/api/slack/oauth
#
# From the app's "Basic Information" page:
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# The PUBLIC https origin where this app is reachable (Slack must reach it, and
# it builds the connect/redirect/deep links). No trailing slash. In local dev
# use a tunnel (e.g. ngrok http 3000) — not http://localhost:3000.
APP_BASE_URL=
